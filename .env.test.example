# Copy to .env.test (gitignored) for running the test suite.
# Must be a throwaway database -- the suite TRUNCATEs every tenant table.
# The database name must contain "test"; it is created on first run if the
# user may CREATE DATABASE. The server needs the pgvector extension.
# Never point this at the dev/production database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/business_chatbot_test
