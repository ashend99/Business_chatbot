# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me
API_V1_PREFIX=/api/v1

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/qna_chatbot
# Used only by the test suite (tests/conftest.py) -- keep separate from DATABASE_URL so
# running pytest never touches dev data.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/qna_chatbot_test

# --- Auth (admin dashboard) ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM / Embeddings (OpenAI) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Email notifications (new lead alerts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Widget / embed security ---
WIDGET_API_KEY_SALT=change-me

# --- CORS (comma-separated allowed origins for local dev) ---
# http://localhost:5173 is the Vite dev server for ui/ (the admin dashboard).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
