# Copy to .env and fill in your local Postgres credentials.
# Production values: see docs/deployment.md.

# development (local) | staging (deployed dev branch) | production.
# Deployed environments refuse to start while any CHANGE_ME placeholder or a
# short JWT_SECRET remains; production also requires EMAIL_BACKEND=smtp.
ENVIRONMENT=development

# postgresql+psycopg:// uses the psycopg3 driver (works for both sync and async engines).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/business_chatbot
# Optional: a direct (non-pooled) connection for `alembic upgrade head`;
# falls back to DATABASE_URL when unset
# MIGRATION_DATABASE_URL=
BCRYPT_ROUNDS=12

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Superadmin login -- env-configured, no DB table for MVP
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_ME

CLIENT_DASHBOARD_URL=https://dashboard.example.com

# console (logs emails) | smtp
EMAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com

# Documents module -- OpenAI embeddings for RAG search. Everything else
# (embedding model, batch/retry tuning, chunking sizes, upload limits) is
# in project_config.yaml -- these two stay here as secret / schema-pinned.
OPENAI_API_KEY=CHANGE_ME
EMBEDDING_DIMENSIONS=1536
